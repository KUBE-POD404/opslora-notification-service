# Opslora notification service environment example.
SERVICE_NAME=notification-service
ENVIRONMENT=development
LOG_LEVEL=INFO
ENV_FILE=

RABBITMQ_URL=amqp://guest:guest@localhost:5672//
RABBITMQ_URL_FILE=
SMTP_HOST=smtp.example.com
SMTP_HOST_FILE=
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_USER_FILE=
SMTP_PASS=change-me
SMTP_PASS_FILE=
SMTP_STARTTLS=true
FROM_EMAIL=noreply@example.com
FROM_EMAIL_FILE=
FROM_NAME=Opslora
